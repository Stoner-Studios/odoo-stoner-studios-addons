msgstr "Token OAuth del Bot para Mensajes Directos y Suscripciones de Eventos (REQUERIDO para funcionalidad del bot)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "This token needs the following scopes: chat:write, im:history, im:read, im:write, users:read"
msgstr "Este token necesita los siguientes scopes: chat:write, im:history, im:read, im:write, users:read"
#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Complete Setup Guide"
msgstr "Guía de Configuración Completa"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "To configure Slack correctly, follow these steps:"
msgstr "Para configurar Slack correctamente, sigue estos pasos:"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Create a Slack App"
msgstr "Crea una Slack App"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Add Bot Token Scopes"
msgstr "Añade Bot Token Scopes"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Install the app"
msgstr "Instala la app"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "in your workspace and copy the Bot Token (xoxb-...)"
msgstr "en tu workspace y copia el Bot Token (xoxb-...)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Copy the Signing Secret"
msgstr "Copia el Signing Secret"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "from App Credentials"
msgstr "desde App Credentials"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Paste the tokens"
msgstr "Pega los tokens"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "in the fields below and save"
msgstr "en los campos de abajo y guarda"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Configure the URLs"
msgstr "Configura las URLs"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "in your Slack App (see below)"
msgstr "en tu Slack App (ver más abajo)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Need detailed help?"
msgstr "¿Necesitas ayuda detallada?"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "URLs to configure in your Slack App"
msgstr "URLs para configurar en tu Slack App"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Replace \"your-odoo-domain.com\" with your actual domain."
msgstr "Sustituye \"your-odoo-domain.com\" con tu dominio real."

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Configure in: Slack App"
msgstr "Configura en: Slack App"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Important:"
msgstr "Importante:"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "After configuring these URLs in Slack, come back here and test the integration by sending a direct message to the bot."
msgstr "Después de configurar estas URLs en Slack, vuelve aquí y prueba la integración enviando un mensaje directo al bot."

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Enable Slack Integration"
msgstr "Activar Integración Slack"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Enable Slack slash command integration"
msgstr "Activa la integración de Slack con el CRM"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Verification Token"
msgstr "Verification Token"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Slack app verification token for validating slash commands (REQUIRED)"
msgstr "Token de verificación de la app de Slack para validar comandos (REQUERIDO)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Signing Secret"
msgstr "Signing Secret"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Slack signing secret for cryptographic request verification (REQUIRED)"
msgstr "Secreto de firma de Slack para verificación criptográfica de peticiones (REQUERIDO)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Bot Token (Commands)"
msgstr "Token del Bot (Comandos)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Slack bot token for opening modals and Web API calls (REQUIRED)"
msgstr "Token del bot de Slack para abrir modales y llamadas a la API Web (REQUERIDO)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Rate Limiting"
msgstr "Límite de Peticiones"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Configure rate limits for Slack requests to prevent abuse"
msgstr "Configura límites de peticiones de Slack para prevenir abusos"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Commands/minute"
msgstr "Comandos/minuto"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Interactions/minute"
msgstr "Interacciones/minuto"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Higher values allow more concurrent usage but may impact server performance. Default: 30 commands/min, 60 interactions/min."
msgstr "Valores más altos permiten más uso concurrente pero pueden afectar el rendimiento del servidor. Por defecto: 30 comandos/min, 60 interacciones/min."

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Slack Integration Endpoints"
msgstr "Endpoints de Integración Slack"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Copy these URLs to configure your Slack App"
msgstr "Copia estas URLs para configurar tu Slack App"

