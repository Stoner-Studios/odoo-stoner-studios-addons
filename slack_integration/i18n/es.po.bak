#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Paste the OAuth URL from below ↓"
msgstr "Pega la OAuth URL de abajo ↓"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Click Add, then Save URLs"
msgstr "Haz clic en Add, luego en Save URLs"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "<strong>STEP 6: Enable bot in Slack</strong>"
msgstr "<strong>PASO 6: Activar bot en Slack</strong>"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "In Slack, go to Apps section (left sidebar)"
msgstr "En Slack, ve a la sección Apps (barra lateral izquierda)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Type \"help\" to get started"
msgstr "Escribe \"help\" para comenzar"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "✅ Done! The bot will send you a link to connect your Odoo account."
msgstr "✅ ¡Listo! El bot te enviará un enlace para conectar tu cuenta de Odoo."

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Wait for the green ✓ \"Verified\" message to appear"
msgstr "Espera a que aparezca el mensaje verde ✓ \"Verified\""

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "If prompted, click <strong>reinstall your app</strong>"
msgstr "Si se solicita, haz clic en <strong>reinstall your app</strong>"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "In Slack, go to the <strong>Apps</strong> section (left sidebar)"
msgstr "En Slack, ve a la sección <strong>Apps</strong> (barra lateral izquierda)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Search for your bot by the name you gave it"
msgstr "Busca tu bot por el nombre que le diste"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Click the bot to enable it and open a direct message (DM)"
msgstr "Haz clic en el bot para activarlo y abrir un mensaje directo (DM)"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Type <strong>\"help\"</strong> to get started"
msgstr "Escribe <strong>\"help\"</strong> para comenzar"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "<strong>✅ Done!</strong> The bot will send you a link to connect your Odoo account."
msgstr "<strong>✅ ¡Listo!</strong> El bot te enviará un enlace para conectar tu cuenta de Odoo."

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Click <strong>Add</strong>, then <strong>Save URLs</strong>"
msgstr "Haz clic en <strong>Add</strong>, luego en <strong>Save URLs</strong>"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Copy the <strong>Verification Token</strong> → Paste it in the field below"
msgstr "Copia el <strong>Verification Token</strong> → Pégalo en el campo de abajo"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Copy the <strong>Signing Secret</strong> → Paste it in the field below"
msgstr "Copia el <strong>Signing Secret</strong> → Pégalo en el campo de abajo"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "Copy the <strong>Bot User OAuth Token</strong> (starts with xoxb-) → Paste it in the field below"
msgstr "Copia el <strong>Bot User OAuth Token</strong> (empieza con xoxb-) → Pégalo en el campo de abajo"

#. module: slack_integration
#: model_terms:ir.ui.view,arch_db:slack_integration.res_config_settings_view_form_slack
msgid "<strong>STEP 5: Enable the bot in Slack</strong>"
msgstr "<strong>PASO 5: Activar el bot en Slack</strong>"
