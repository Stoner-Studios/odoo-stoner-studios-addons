        <!-- Explicit model definitions for ir.model.access.csv references -->
        <record id="model_slack_user_mapping" model="ir.model">
            <field name="model">slack.user.mapping</field>
            <field name="name">Slack User Mapping</field>
            <field name="info">Model for mapping Slack users to Odoo users</field>
        </record>

        <record id="model_slack_conversation" model="ir.model">
            <field name="model">slack.conversation</field>
            <field name="name">Slack Conversation</field>
            <field name="info">Model for tracking Slack conversations</field>
        </record>

        <record id="model_slack_security_log" model="ir.model">
            <field name="model">slack.security.log</field>
            <field name="name">Slack Security Log</field>
            <field name="info">Security audit log for Slack integration</field>
        </record>
    </data>
</odoo>
