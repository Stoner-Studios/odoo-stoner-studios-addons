<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action to cleanup old security logs -->
        <record id="ir_cron_cleanup_slack_security_logs" model="ir.cron">
            <field name="name">Slack: Cleanup Security Logs</field>
            <field name="model_id" ref="model_slack_security_log"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_logs(days=45)</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Scheduled Action to cleanup expired OAuth states -->
        <record id="ir_cron_cleanup_oauth_states" model="ir.cron">
            <field name="name">Slack: Cleanup Expired OAuth States</field>
            <field name="model_id" ref="model_slack_user_mapping"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_expired_oauth_states()</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Scheduled Action to cleanup idle conversations -->
        <record id="ir_cron_cleanup_idle_conversations" model="ir.cron">
            <field name="name">Slack: Cleanup Idle Conversations</field>
            <field name="model_id" ref="model_slack_conversation"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_idle_conversations(hours=72)</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>